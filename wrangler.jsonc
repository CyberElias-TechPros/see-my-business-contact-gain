{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gainhub-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "APP_ENV": "development",
    "ALLOWED_ORIGINS": "http://localhost:3000,http://localhost:5173,http://localhost:8788",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gainhub-development",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "worker/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "gainhub-evidence-development",
    },
  ],
  "triggers": {
    "crons": ["17 3 * * *"],
  },
  "env": {
    "preview": {
      "name": "gainhub-api-preview",
      "vars": {
        "APP_ENV": "preview",
        "ALLOWED_ORIGINS": "https://preview.gainhub.example",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gainhub-preview",
          "database_id": "11111111-1111-4111-8111-111111111111",
          "migrations_dir": "worker/migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "EVIDENCE",
          "bucket_name": "gainhub-evidence-preview",
        },
      ],
    },
    "production": {
      "name": "gainhub-api-production",
      "vars": {
        "APP_ENV": "production",
        "ALLOWED_ORIGINS": "https://gainhub.example,https://www.gainhub.example",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gainhub-production",
          "database_id": "4e87c945-99bf-4144-825d-d1ce49b91dfa",
          "migrations_dir": "worker/migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "EVIDENCE",
          "bucket_name": "gainhub-evidence-production",
        },
      ],
    },
  },
}
