# Server-only origin used by the Vercel/TanStack same-origin proxy.
# Local default is http://127.0.0.1:8787 when this variable is omitted.
CLOUDFLARE_API_URL=https://api.your-domain.example
# Same random 32+ character value as the Worker's PROXY_SHARED_SECRET.
CLOUDFLARE_PROXY_SECRET=replace-with-a-random-shared-proxy-value

# Public values compiled into metadata and legal/support pages.
VITE_SITE_URL=https://www.your-domain.example
VITE_LEGAL_OPERATOR_NAME=Your registered legal operator name
VITE_PRIVACY_EMAIL=privacy@your-domain.example
VITE_SUPPORT_EMAIL=support@your-domain.example
# Obtain jurisdiction-specific legal review before setting these production values.
VITE_GOVERNING_LAW=Your reviewed governing-law wording
VITE_DISPUTE_FORUM=Your reviewed court or dispute-resolution forum
