{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "${{env.API_URL}}/api/v1/:path*" },
    { "source": "/media/:path*", "destination": "${{env.API_URL}}/media/:path*" },
    { "source": "/go/:code", "destination": "${{env.API_URL}}/go/:code" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "cache-control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "x-content-type-options", "value": "nosniff" },
        { "key": "referrer-policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "permissions-policy",
          "value": "geolocation=(self), camera=(), microphone=(), display-capture=()"
        }
      ]
    }
  ]
}
